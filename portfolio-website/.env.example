# Portfolio website — environment variables (TECH-STACK.md §10).
# Copy to .env.local for local development. Set the real values in the
# Vercel dashboard for previews and production. .env.local is gitignored.

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=

# Supabase (Postgres + pgvector + storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Langfuse (LLM observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cost ceiling + alerting
DAILY_BUDGET_USD=20
ADMIN_ALERT_WEBHOOK=

# Public site
NEXT_PUBLIC_SITE_URL=https://sowthri.dev
